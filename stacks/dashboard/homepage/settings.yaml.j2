# {{ ansible_managed }}
title: {{ hostname }}
language: de
theme: dark
color: slate
headerStyle: boxed
hideVersion: true
{% if aun_layout | bool %}
# AUN-Layout (assets/aun-layout), das Playbook legt die Bilder nach images/
favicon: /images/aun-favicon.png
background:
  image: /images/hintergrund.jpg
  blur: sm
  brightness: 50
  opacity: 50
{% endif %}
layout:
  Verwaltung:
    style: row
    columns: 4
  Überwachung:
    style: row
    columns: 4
  Medien:
    style: row
    columns: 4
  Netzwerk:
    style: row
    columns: 4
